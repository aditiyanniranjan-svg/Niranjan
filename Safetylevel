<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Neighbourhood Safety Level Predictor — Tamil Nadu Safety Analytics</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <style>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .sos-pulse {
      box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5);
      animation: pulse-ring 2s infinite;
    }
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.5); }
      70% { box-shadow: 0 0 0 18px rgba(220, 38, 38, 0); }
      100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col">

  <!-- Top Header -->
  <header class="bg-[#0B2A5B] text-white border-b border-blue-950 sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-md bg-amber-400 text-[#0B2A5B] font-extrabold flex items-center justify-center text-sm">
          NS
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-bold leading-tight">Neighbourhood Safety Level Predictor</h1>
          <p class="text-xs text-blue-200">Tamil Nadu Crime &amp; Safety Analytics &middot; Dept. of IT, E.G.S. Pillay Engineering College</p>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs text-blue-100">
        <span class="hidden md:inline-block bg-white/10 px-2.5 py-1 rounded">Team: Niranjan S &middot; Nithish T &middot; Nasarath Ali</span>
        <button type="button" id="resetMapViewBtn" class="px-2.5 py-1.5 rounded bg-white/10 hover:bg-white/20 text-white font-medium transition">
          Reset TN Map
        </button>
      </div>
    </div>

    <!-- Mobile / Tablet Navigation Bar -->
    <nav class="lg:hidden bg-[#081F44] px-4 py-2 flex items-center gap-1.5 overflow-x-auto" aria-label="Mobile navigation">
      <button type="button" data-tab="dashboard" class="tab-btn px-3 py-1.5 rounded text-xs font-semibold bg-amber-400 text-[#0B2A5B] shrink-0">
        Dashboard &amp; Map
      </button>
      <button type="button" data-tab="predictor" class="tab-btn px-3 py-1.5 rounded text-xs font-semibold text-blue-100 hover:bg-white/10 shrink-0">
        ML Predictor
      </button>
      <button type="button" data-tab="sos" class="tab-btn px-3 py-1.5 rounded text-xs font-semibold text-blue-100 hover:bg-white/10 shrink-0 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-red-400"></span>
        Emergency SOS
      </button>
      <button type="button" data-tab="admin" class="tab-btn px-3 py-1.5 rounded text-xs font-semibold text-blue-100 hover:bg-white/10 shrink-0">
        Dataset &amp; Model
      </button>
    </nav>
  </header>

  <!-- Toast Banner -->
  <div id="toast" class="fixed bottom-5 right-5 z-50 hidden max-w-sm bg-slate-900 text-white text-sm px-4 py-3 rounded-lg shadow-lg border border-slate-700"></div>

  <!-- Dashboard Shell -->
  <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-5 flex gap-6">

    <!-- Desktop Sidebar -->
    <aside class="hidden lg:flex flex-col w-60 shrink-0 space-y-4">
      <div class="bg-white rounded-xl border border-slate-200 p-3 shadow-sm space-y-1">
        <p class="px-3 pt-1 pb-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">Modules</p>
        <button type="button" data-tab="dashboard" class="tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold bg-[#0B2A5B] text-white transition">
          Dashboard &amp; Map
        </button>
        <button type="button" data-tab="predictor" class="tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 transition">
          ML Risk Predictor
        </button>
        <button type="button" data-tab="sos" class="tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 transition flex items-center justify-between">
          <span>Emergency SOS</span>
          <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
        </button>
        <button type="button" data-tab="admin" class="tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 transition">
          Dataset &amp; Model
        </button>
      </div>

      <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm text-xs space-y-2">
        <p class="font-bold text-[#0B2A5B]">Risk Classification</p>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>Low Risk</span>
          <span class="font-mono text-slate-500">0 – 34</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>Medium Risk</span>
          <span class="font-mono text-slate-500">35 – 64</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>High Risk</span>
          <span class="font-mono text-slate-500">65 – 100</span>
        </div>
        <div class="pt-2 border-t border-slate-100 text-[11px] text-slate-500">
          Guided by V. Suriya, AP/IT
        </div>
      </div>
    </aside>

    <!-- Main Workspace -->
    <main class="flex-1 min-w-0 space-y-5">

      <!-- High-Risk Alert Banner -->
      <div id="highRiskBanner" class="hidden bg-red-50 border border-red-300 rounded-xl p-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-start gap-3">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-red-600 text-white font-bold text-sm shrink-0">!</span>
          <div>
            <p class="text-sm font-bold text-red-900" id="highRiskBannerTitle">High-Risk Zone Warning</p>
            <p class="text-xs text-red-700" id="highRiskBannerText">This area is classified as High Risk. Keep emergency contacts active.</p>
          </div>
        </div>
        <button type="button" id="bannerSosBtn" class="px-3.5 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold transition">
          Trigger SOS Alert
        </button>
      </div>

      <!-- TAB 1: DASHBOARD & MAP -->
      <section id="tab-dashboard" class="tab-panel space-y-5">

        <!-- Filter & Search Controls -->
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5 flex-1">
            <input id="searchInput" type="text" placeholder="Search area or city in Tamil Nadu..."
              class="w-full sm:w-64 px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0B2A5B]" />
            <select id="districtFilter" aria-label="Filter by district or city"
              class="px-3 py-2 rounded-lg border border-slate-300 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-[#0B2A5B]">
              <option value="All">All Tamil Nadu Districts</option>
            </select>
          </div>
          <div class="flex items-center gap-1.5" role="group" aria-label="Risk level filter">
            <button type="button" data-filter="All" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#0B2A5B] text-white">All</button>
            <button type="button" data-filter="Low" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">Low</button>
            <button type="button" data-filter="Medium" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">Medium</button>
            <button type="button" data-filter="High" class="filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200">High</button>
          </div>
        </div>

        <!-- KPI Summary Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
            <p class="text-xs font-medium text-slate-500">Tamil Nadu Areas</p>
            <p class="text-2xl font-bold text-[#0B2A5B] mt-1" id="kpiTotal">0</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
            <p class="text-xs font-medium text-slate-500">Low-Risk Zones</p>
            <p class="text-2xl font-bold text-emerald-600 mt-1" id="kpiLow">0</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
            <p class="text-xs font-medium text-slate-500">Medium-Risk Zones</p>
            <p class="text-2xl font-bold text-amber-600 mt-1" id="kpiMedium">0</p>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
            <p class="text-xs font-medium text-slate-500">High-Risk Zones</p>
            <p class="text-2xl font-bold text-red-600 mt-1" id="kpiHigh">0</p>
          </div>
        </div>

        <!-- Interactive Map + Area Directory -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">
          <div class="xl:col-span-2 bg-white rounded-xl border border-slate-200 p-4 shadow-sm">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h2 class="text-sm font-bold text-[#0B2A5B]">Tamil Nadu Interactive Safety Map</h2>
                <p class="text-xs text-slate-500">Click any marker to inspect area risk metrics</p>
              </div>
              <span class="text-xs text-slate-500" id="mapCountLabel">0 locations shown</span>
            </div>
            <div id="safetyMap" class="w-full rounded-lg border border-slate-200 z-10" style="height: 360px;"></div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-sm font-bold text-[#0B2A5B]">Neighbourhood Directory</h2>
              <span class="text-xs text-slate-400" id="dirCount">0</span>
            </div>
            <div id="areaList" class="space-y-2 overflow-y-auto max-h-[360px] pr-1"></div>
          </div>
        </div>

        <!-- Selected Area Card + Risk Score Chart -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-start justify-between gap-2">
                <div>
                  <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400" id="selectedDistrict">District</p>
                  <h2 class="text-lg font-bold text-[#0B2A5B] mt-0.5" id="selectedName">—</h2>
                </div>
                <span id="selectedBadge" class="px-3 py-1 rounded-full text-xs font-bold">—</span>
              </div>

              <div id="selectedBox" class="mt-4 rounded-lg border p-4 text-center">
                <p class="text-[11px] uppercase tracking-wider font-semibold opacity-75">ML Risk Classification</p>
                <p class="text-2xl font-extrabold mt-1" id="selectedRiskHeadline">—</p>
                <p class="text-xs mt-1" id="selectedRiskScoreText">Safety Risk Score: — / 100</p>
              </div>

              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
                <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                  <p class="text-[11px] text-slate-500">Crime Index</p>
                  <p class="text-sm font-bold text-slate-900 mt-0.5" id="selectedCrime">—</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                  <p class="text-[11px] text-slate-500">Streetlights</p>
                  <p class="text-sm font-bold text-slate-900 mt-0.5" id="selectedLighting">—</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                  <p class="text-[11px] text-slate-500">Pop. Density</p>
                  <p class="text-sm font-bold text-slate-900 mt-0.5" id="selectedDensity">—</p>
                </div>
                <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                  <p class="text-[11px] text-slate-500">Police Patrol</p>
                  <p class="text-sm font-bold text-slate-900 mt-0.5" id="selectedPolice">—</p>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
              <span id="selectedCoords">Coordinates: —</span>
              <button type="button" id="openPredictorFromCard" class="text-[#0B2A5B] font-semibold hover:underline">
                Analyze in ML Predictor &rarr;
              </button>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm flex flex-col">
            <div class="mb-3">
              <h2 class="text-sm font-bold text-[#0B2A5B]">Area Risk Comparison (Top 10 Filtered)</h2>
              <p class="text-xs text-slate-500">Red = High &middot; Amber = Medium &middot; Green = Low</p>
            </div>
            <div class="relative h-72 w-full">
              <canvas id="crimeChart"></canvas>
            </div>
          </div>
        </div>
      </section>

      <!-- TAB 2: ML RISK PREDICTOR -->
      <section id="tab-predictor" class="tab-panel hidden space-y-5">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <form id="predictorForm" class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-4">
            <div>
              <h2 class="text-base font-bold text-[#0B2A5B]">ML Safety Classification Model</h2>
              <p class="text-xs text-slate-500 mt-1">Input crime, lighting, density, and patrol parameters to predict area risk.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label for="predName" class="block text-xs font-semibold text-slate-700 mb-1">Neighbourhood Name</label>
                <input id="predName" type="text" value="Custom Area" required
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0B2A5B]" />
              </div>
              <div>
                <label for="predDistrict" class="block text-xs font-semibold text-slate-700 mb-1">District</label>
                <input id="predDistrict" type="text" value="Chennai" required
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-[#0B2A5B]" />
              </div>
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                <label for="predCrime">Past Crime Index (0–100)</label>
                <span id="predCrimeVal" class="text-[#0B2A5B]">45</span>
              </div>
              <input id="predCrime" type="range" min="0" max="100" value="45" class="w-full accent-[#0B2A5B]" />
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                <label for="predLighting">Streetlight Coverage (%)</label>
                <span id="predLightingVal" class="text-[#0B2A5B]">65%</span>
              </div>
              <input id="predLighting" type="range" min="0" max="100" value="65" class="w-full accent-[#0B2A5B]" />
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                <label for="predDensity">Population Density (per km&sup2;)</label>
                <span id="predDensityVal" class="text-[#0B2A5B]">15,000</span>
              </div>
              <input id="predDensity" type="range" min="1000" max="35000" step="500" value="15000" class="w-full accent-[#0B2A5B]" />
            </div>

            <div>
              <label for="predPolice" class="block text-xs font-semibold text-slate-700 mb-1">Police Patrol Presence</label>
              <select id="predPolice" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-[#0B2A5B]">
                <option value="High">High (Frequent patrols / nearby station)</option>
                <option value="Medium" selected>Medium (Regular patrols)</option>
                <option value="Low">Low (Limited patrols)</option>
              </select>
            </div>

            <div class="flex flex-wrap gap-3 pt-2">
              <button type="submit" class="px-4 py-2 rounded-lg bg-[#0B2A5B] hover:bg-blue-900 text-white text-sm font-semibold transition">
                Run Prediction
              </button>
              <button type="button" id="savePredToDashboard" class="px-4 py-2 rounded-lg bg-amber-400 hover:bg-amber-500 text-[#0B2A5B] text-sm font-bold transition">
                Save to Dashboard
              </button>
            </div>
          </form>

          <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-5">
            <div>
              <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Classification Output</p>
              <h3 class="text-lg font-bold text-[#0B2A5B] mt-1" id="predOutputTitle">Custom Area</h3>

              <div id="predResultBox" class="mt-4 rounded-xl border p-6 text-center">
                <p class="text-xs font-semibold uppercase tracking-wider opacity-75">Predicted Safety Level</p>
                <p class="text-3xl font-extrabold mt-1" id="predCategory">—</p>
                <p class="text-sm font-medium mt-1" id="predScoreText">Composite Risk Score: — / 100</p>
              </div>

              <div class="mt-5 space-y-3">
                <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Feature Contribution</p>
                <div class="space-y-2 text-xs">
                  <div>
                    <div class="flex justify-between mb-1"><span>Crime Reports Weight (45%)</span><span id="contribCrime">—</span></div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div id="barCrime" class="h-full bg-red-500 rounded-full" style="width:0%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1"><span>Lighting Deficit Weight (30%)</span><span id="contribLight">—</span></div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div id="barLight" class="h-full bg-amber-500 rounded-full" style="width:0%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1"><span>Density Factor Weight (15%)</span><span id="contribDensity">—</span></div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div id="barDensity" class="h-full bg-blue-500 rounded-full" style="width:0%"></div></div>
                  </div>
                  <div>
                    <div class="flex justify-between mb-1"><span>Police Patrol Offset (-10%)</span><span id="contribPolice">—</span></div>
                    <div class="h-2 bg-slate-100 rounded-full overflow-hidden"><div id="barPolice" class="h-full bg-emerald-500 rounded-full" style="width:0%"></div></div>
                  </div>
                </div>
              </div>
            </div>

            <p class="text-xs text-slate-500 border-t border-slate-100 pt-3">
              Thresholds: Low (&lt; 35), Medium (35–64), High (&ge; 65).
            </p>
          </div>
        </div>
      </section>

      <!-- TAB 3: EMERGENCY SOS -->
      <section id="tab-sos" class="tab-panel hidden space-y-5">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm flex flex-col items-center justify-center text-center space-y-5">
            <div>
              <h2 class="text-lg font-bold text-[#0B2A5B]">Emergency Alert (SOS) Module</h2>
              <p class="text-xs text-slate-500 mt-1">Dispatches live location coordinates to the nearest police control room and registered contacts.</p>
            </div>

            <button type="button" id="sosMainBtn"
              class="sos-pulse w-40 h-40 rounded-full bg-red-600 hover:bg-red-700 active:scale-95 text-white font-extrabold text-4xl tracking-wider border-4 border-red-800 transition flex items-center justify-center">
              SOS
            </button>

            <p class="text-sm font-bold text-red-700">Tap SOS to share live location</p>

            <div class="w-full max-w-md bg-slate-50 border border-slate-200 rounded-lg p-3 text-xs text-left space-y-1">
              <div class="flex justify-between">
                <span class="font-semibold text-slate-600">Coordinates:</span>
                <span id="sosCoordsDisplay" class="font-mono text-slate-800">13.0850, 80.2101</span>
              </div>
              <div class="flex justify-between">
                <span class="font-semibold text-slate-600">Location:</span>
                <span id="sosAreaDisplay" class="text-slate-800 font-medium">Anna Nagar, Chennai</span>
              </div>
            </div>

            <div class="flex flex-wrap gap-2 justify-center">
              <button type="button" id="detectGpsBtn" class="px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-semibold transition">
                Detect Browser GPS
              </button>
              <button type="button" id="resetSosBtn" class="px-3.5 py-2 rounded-lg border border-slate-300 hover:bg-slate-100 text-slate-700 text-xs font-semibold transition">
                Reset Alert Status
              </button>
            </div>
          </div>

          <div class="bg-white rounded-xl border border-slate-200 p-6 shadow-sm space-y-5">
            <div class="flex items-center justify-between">
              <h3 class="text-base font-bold text-[#0B2A5B]">Notification Status</h3>
              <span id="sosOverallStatus" class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">Standby</span>
            </div>

            <div class="space-y-3">
              <div>
                <label for="contactPolice" class="block text-xs font-semibold text-slate-600 mb-1">Police Station</label>
                <div class="flex gap-2 items-center">
                  <input id="contactPolice" type="text" value="Tamil Nadu Police Control Room (100 / 112)" class="flex-1 px-3 py-2 rounded-lg border border-slate-300 text-xs" />
                  <span id="statusPolice" class="px-3 py-2 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 min-w-[84px] text-center">Standby</span>
                </div>
              </div>

              <div>
