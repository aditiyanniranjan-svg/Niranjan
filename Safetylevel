  <footer class="bg-white border-t border-slate-200 py-3 px-4 text-center text-xs text-slate-500">
    Neighbourhood Safety Level Predictor &middot; E.G.S. Pillay Engineering College, Nagapattinam
  </footer>

  <script>
    // --- Classification Model ---
    function classifyArea(crime, lighting, density, police) {
      const crimePart = 0.45 * Math.min(100, Math.max(0, crime));
      const lightPart = 0.30 * (100 - Math.min(100, Math.max(0, lighting)));
      const densityNorm = Math.min(100, (Math.max(0, density) / 35000) * 100);
      const densityPart = 0.15 * densityNorm;
      const policeBonus = police === 'High' ? 10 : police === 'Medium' ? 5 : 0;
      const score = Math.round(Math.min(100, Math.max(0, crimePart + lightPart + densityPart - policeBonus + 5)));
      let level = 'Low';
      if (score >= 65) level = 'High';
      else if (score >= 35) level = 'Medium';
      return {
        score,
        level,
        parts: {
          crime: Math.round(crimePart),
          light: Math.round(lightPart),
          density: Math.round(densityPart),
          police: policeBonus
        }
      };
    }

    // --- Tamil Nadu Locations Dataset (19 Verified Coordinates) ---
    let areas = [
      { id: 1, name: 'Anna Nagar', district: 'Chennai', lat: 13.0850, lng: 80.2101, crime: 42, lighting: 68, density: 18500, police: 'Medium' },
      { id: 2, name: 'Adyar', district: 'Chennai', lat: 13.0063, lng: 80.2574, crime: 22, lighting: 88, density: 13500, police: 'High' },
      { id: 3, name: 'Chennai Central', district: 'Chennai', lat: 13.0878, lng: 80.2785, crime: 76, lighting: 48, density: 28000, police: 'Medium' },
      { id: 4, name: 'Guindy', district: 'Chennai', lat: 13.0109, lng: 80.2354, crime: 52, lighting: 62, density: 19000, police: 'Medium' },
      { id: 5, name: 'Velachery', district: 'Chennai', lat: 12.9758, lng: 80.2205, crime: 44, lighting: 66, density: 21000, police: 'Medium' },
      { id: 6, name: 'Tambaram', district: 'Chennai', lat: 12.9229, lng: 80.1275, crime: 49, lighting: 60, density: 17500, police: 'Medium' },
      { id: 7, name: 'Nagapattinam', district: 'Nagapattinam', lat: 10.7906, lng: 79.8428, crime: 24, lighting: 80, density: 9500, police: 'High' },
      { id: 8, name: 'Salem', district: 'Salem', lat: 11.6643, lng: 78.1460, crime: 46, lighting: 65, density: 16500, police: 'Medium' },
      { id: 9, name: 'Coimbatore', district: 'Coimbatore', lat: 11.0000, lng: 77.0000, crime: 38, lighting: 74, density: 19500, police: 'High' },
      { id: 10, name: 'Madurai', district: 'Madurai', lat: 9.9667, lng: 78.1667, crime: 68, lighting: 52, density: 22000, police: 'Medium' },
      { id: 11, name: 'Tiruchirappalli', district: 'Tiruchirappalli', lat: 10.8064, lng: 78.6892, crime: 40, lighting: 70, density: 16000, police: 'High' },
      { id: 12, name: 'Erode', district: 'Erode', lat: 11.3333, lng: 77.7667, crime: 28, lighting: 79, density: 13000, police: 'High' },
      { id: 13, name: 'Thanjavur', district: 'Thanjavur', lat: 10.7833, lng: 79.1667, crime: 25, lighting: 82, density: 11500, police: 'High' },
      { id: 14, name: 'Thoothukudi', district: 'Thoothukudi', lat: 8.7642, lng: 78.1348, crime: 66, lighting: 50, density: 15500, police: 'Low' },
      { id: 15, name: 'Tiruppur', district: 'Tiruppur', lat: 11.1122, lng: 77.3544, crime: 58, lighting: 58, density: 20500, police: 'Medium' },
      { id: 16, name: 'Dindigul', district: 'Dindigul', lat: 10.3690, lng: 77.9800, crime: 36, lighting: 72, density: 12500, police: 'Medium' },
      { id: 17, name: 'Nagercoil', district: 'Kanyakumari', lat: 8.1833, lng: 77.4119, crime: 20, lighting: 86, density: 11000, police: 'High' },
      { id: 18, name: 'Kanchipuram', district: 'Kanchipuram', lat: 12.8333, lng: 79.7500, crime: 31, lighting: 76, density: 13000, police: 'High' },
      { id: 19, name: 'Karur', district: 'Karur', lat: 10.9667, lng: 78.1167, crime: 27, lighting: 78, density: 10500, police: 'High' }
    ].map(a => ({ ...a, ...classifyArea(a.crime, a.lighting, a.density, a.police) }));

    let nextId = 20;
    let selectedId = 1;
    let currentFilter = 'All';
    let currentDistrict = 'All';
    let searchQuery = '';
    let alertLogs = [];
    let chartInstance = null;
    let mapInstance = null;
    let markersLayer = null;

    function riskStyles(level) {
      if (level === 'High') {
        return {
          badge: 'bg-red-100 text-red-800 border border-red-200',
          box: 'bg-red-50 border-red-300 text-red-900',
          hex: '#DC2626'
        };
      }
      if (level === 'Medium') {
        return {
          badge: 'bg-amber-100 text-amber-800 border border-amber-200',
          box: 'bg-amber-50 border-amber-300 text-amber-900',
          hex: '#D97706'
        };
      }
      return {
        badge: 'bg-emerald-100 text-emerald-800 border border-emerald-200',
        box: 'bg-emerald-50 border-emerald-300 text-emerald-900',
        hex: '#16A34A'
      };
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.remove('hidden');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => el.classList.add('hidden'), 3200);
    }

    function switchTab(tabName) {
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById('tab-' + tabName).classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(btn => {
        const active = btn.dataset.tab === tabName;
        const isDesktop = btn.closest('aside') !== null;
        if (isDesktop) {
          btn.className = active
            ? 'tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold bg-[#0B2A5B] text-white transition flex items-center justify-between'
            : 'tab-btn w-full text-left px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 transition flex items-center justify-between';
        } else {
          btn.className = active
            ? 'tab-btn px-3 py-1.5 rounded text-xs font-semibold bg-amber-400 text-[#0B2A5B] shrink-0 flex items-center gap-1.5'
            : 'tab-btn px-3 py-1.5 rounded text-xs font-semibold text-blue-100 hover:bg-white/10 shrink-0 flex items-center gap-1.5';
        }
      });

      if (tabName === 'dashboard' && mapInstance) {
        setTimeout(() => mapInstance.invalidateSize(), 120);
      }
    }

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.dataset.tab));
    });

    function populateDistrictDropdown() {
      const sel = document.getElementById('districtFilter');
      const districts = Array.from(new Set(areas.map(a => a.district))).sort();
      sel.innerHTML = '<option value="All">All Tamil Nadu Districts</option>' +
        districts.map(d => `<option value="${d}">${d}</option>`).join('');
      sel.value = districts.includes(currentDistrict) ? currentDistrict : 'All';
    }

    function getFilteredAreas() {
      return areas.filter(a => {
        const matchesRisk = currentFilter === 'All' || a.level === currentFilter;
        const matchesDistrict = currentDistrict === 'All' || a.district === currentDistrict;
        const q = searchQuery.toLowerCase();
        const matchesSearch = a.name.toLowerCase().includes(q) || a.district.toLowerCase().includes(q);
        return matchesRisk && matchesDistrict && matchesSearch;
      });
    }

    function renderKPIs() {
      const list = getFilteredAreas();
      document.getElementById('kpiTotal').textContent = list.length;
      document.getElementById('kpiLow').textContent = list.filter(a => a.level === 'Low').length;
      document.getElementById('kpiMedium').textContent = list.filter(a => a.level === 'Medium').length;
      document.getElementById('kpiHigh').textContent = list.filter(a => a.level === 'High').length;
    }

    function renderSelectedArea() {
      const area = areas.find(a => a.id === selectedId) || areas[0];
      if (!area) return;
      selectedId = area.id;
      const st = riskStyles(area.level);

      document.getElementById('selectedDistrict').textContent = area.district + ' District, Tamil Nadu';
      document.getElementById('selectedName').textContent = area.name;

      const badge = document.getElementById('selectedBadge');
      badge.textContent = area.level.toUpperCase() + ' RISK';
      badge.className = 'px-3 py-1 rounded-full text-xs font-bold ' + st.badge;

      const box = document.getElementById('selectedBox');
      box.className = 'mt-4 rounded-lg border p-4 text-center ' + st.box;
      document.getElementById('selectedRiskHeadline').textContent = area.level.toUpperCase() + ' RISK';
      document.getElementById('selectedRiskScoreText').textContent = `Safety Risk Score: ${area.score} / 100`;

      document.getElementById('selectedCrime').textContent = `${area.crime} / 100`;
      document.getElementById('selectedLighting').textContent = `${area.lighting}%`;
      document.getElementById('selectedDensity').textContent = area.density.toLocaleString();
      document.getElementById('selectedPolice').textContent = area.police;
      document.getElementById('selectedCoords').textContent = `Coordinates: ${area.lat.toFixed(4)}, ${area.lng.toFixed(4)}`;

      document.getElementById('sosCoordsDisplay').textContent = `${area.lat.toFixed(4)}, ${area.lng.toFixed(4)}`;
      document.getElementById('sosAreaDisplay').textContent = `${area.name}, ${area.district}`;

      const banner = document.getElementById('highRiskBanner');
      if (area.level === 'High') {
        document.getElementById('highRiskBannerTitle').textContent = `High-Risk Zone Alert: ${area.name} (${area.district})`;
        document.getElementById('highRiskBannerText').textContent = `Risk score is ${area.score}/100. Keep emergency contacts ready or trigger SOS if needed.`;
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }
    }

    function renderAreaList() {
      const container = document.getElementById('areaList');
      const filtered = getFilteredAreas();
      document.getElementById('dirCount').textContent = `${filtered.length} areas`;
      document.getElementById('mapCountLabel').textContent = `${filtered.length} locations shown`;

      if (filtered.length === 0) {
        container.innerHTML = '<p class="text-xs text-slate-400 italic py-4 text-center">No matching areas found.</p>';
        return;
      }
      container.innerHTML = filtered.map(a => {
        const st = riskStyles(a.level);
        const isSel = a.id === selectedId;
        return `
          <button type="button" data-area-id="${a.id}"
            class="area-item w-full text-left p-2.5 rounded-lg border transition flex items-center justify-between gap-2 ${isSel ? 'border-[#0B2A5B] bg-blue-50/70' : 'border-slate-200 hover:bg-slate-50'}">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-slate-900 truncate">${a.name}</p>
              <p class="text-[11px] text-slate-500 truncate">${a.district} &middot; Score: ${a.score}/100</p>
            </div>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold shrink-0 ${st.badge}">${a.level}</span>
          </button>
        `;
      }).join('');
    }

    document.getElementById('areaList').addEventListener('click', e => {
      const btn = e.target.closest('.area-item');
      if (!btn) return;
      selectArea(Number(btn.dataset.areaId));
    });

    function selectArea(id) {
      selectedId = id;
      const area = areas.find(a => a.id === id);
      renderSelectedArea();
      renderAreaList();
      if (area && mapInstance) {
        mapInstance.setView([area.lat, area.lng], 11, { animate: true });
      }
    }

    function renderChart() {
      const ctx = document.getElementById('crimeChart').getContext('2d');
      const filtered = [...getFilteredAreas()].sort((a, b) => b.score - a.score).slice(0, 10);
      const labels = filtered.map(a => a.name);
      const data = filtered.map(a => a.score);
      const colors = filtered.map(a => riskStyles(a.level).hex);

      if (chartInstance) chartInstance.destroy();
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            label: 'Risk Score (0–100)',
            data,
            backgroundColor: colors,
            borderRadius: 5
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { min: 0, max: 100, grid: { color: '#F1F5F9' } },
            y: { grid: { display: false } }
          }
        }
      });
    }

    function initMap() {
      mapInstance = L.map('safetyMap').setView([10.95, 78.55], 7);
      L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}.jpg', {
        attribution: 'Tiles &copy; Esri',
        maxZoom: 18
      }).addTo(mapInstance);
      markersLayer = L.layerGroup().addTo(mapInstance);
      renderMarkers();
    }

    function renderMarkers() {
      if (!markersLayer) return;
      markersLayer.clearLayers();
      const filtered = getFilteredAreas();
      filtered.forEach(a => {
        const st = riskStyles(a.level);
        const marker = L.circleMarker([a.lat, a.lng], {
          radius: 9,
          fillColor: st.hex,
          color: '#FFFFFF',
          weight: 2,
          opacity: 1,
          fillOpacity: 0.92
        });
        marker.bindPopup(`
          <div style="font-family: Inter, sans-serif; min-width: 150px;">
            <strong>${a.name}</strong> (${a.district})<br/>
            <span>Risk: <strong style="color:${st.hex};">${a.level} (${a.score}/100)</strong></span><br/>
            <span style="font-size:11px;color:#475569;">Crime: ${a.crime} | Lights: ${a.lighting}%</span>
          </div>
        `);
        marker.on('click', () => selectArea(a.id));
        marker.addTo(markersLayer);
      });
    }

    document.getElementById('resetMapViewBtn').addEventListener('click', () => {
      switchTab('dashboard');
      if (mapInstance) mapInstance.setView([10.95, 78.55], 7, { animate: true });
    });

    document.getElementById('searchInput').addEventListener('input', e => {
      searchQuery = e.target.value;
      renderKPIs();
      renderAreaList();
      renderChart();
      renderMarkers();
    });

    document.getElementById('districtFilter').addEventListener('change', e => {
      currentDistrict = e.target.value;
      renderKPIs();
      renderAreaList();
      renderChart();
      renderMarkers();
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter;
        document.querySelectorAll('.filter-btn').forEach(b => {
          const active = b.dataset.filter === currentFilter;
          b.className = active
            ? 'filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#0B2A5B] text-white'
            : 'filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 hover:bg-slate-200';
        });
        renderKPIs();
        renderAreaList();
        renderChart();
        renderMarkers();
      });
    });

    document.getElementById('openPredictorFromCard').addEventListener('click', () => {
      const area = areas.find(a => a.id === selectedId);
      if (area) {
        document.getElementById('predName').value = area.name + ' (Test)';
        document.getElementById('predDistrict').value = area.district;
        document.getElementById('predCrime').value = area.crime;
        document.getElementById('predLighting').value = area.lighting;
        document.getElementById('predDensity').value = area.density;
        document.getElementById('predPolice').value = area.police;
        updatePredictorUI();
      }
      switchTab('predictor');
    });

    function updatePredictorUI() {
      const name = document.getElementById('predName').value.trim() || 'Custom Area';
      const crime = Number(document.getElementById('predCrime').value);
      const lighting = Number(document.getElementById('predLighting').value);
      const density = Number(document.getElementById('predDensity').value);
      const police = document.getElementById('predPolice').value;

      document.getElementById('predCrimeVal').textContent = crime;
      document.getElementById('predLightingVal').textContent = lighting + '%';
      document.getElementById('predDensityVal').textContent = density.toLocaleString();

      const res = classifyArea(crime, lighting, density, police);
      const st = riskStyles(res.level);

      document.getElementById('predOutputTitle').textContent = name;
      document.getElementById('predResultBox').className = 'mt-4 rounded-xl border p-6 text-center ' + st.box;
      document.getElementById('predCategory').textContent = res.level.toUpperCase() + ' RISK';
      document.getElementById('predScoreText').textContent = `Composite Risk Score: ${res.score} / 100`;

      document.getElementById('contribCrime').textContent = `+${res.parts.crime} pts`;
      document.getElementById('barCrime').style.width = Math.min(100, res.parts.crime * 2) + '%';

      document.getElementById('contribLight').textContent = `+${res.parts.light} pts`;
      document.getElementById('barLight').style.width = Math.min(100, res.parts.light * 3) + '%';

      document.getElementById('contribDensity').textContent = `+${res.parts.density} pts`;
      document.getElementById('barDensity').style.width = Math.min(100, res.parts.density * 6) + '%';

      document.getElementById('contribPolice').textContent = `-${res.parts.police} pts`;
      document.getElementById('barPolice').style.width = (res.parts.police * 10) + '%';
    }

    ['predName', 'predDistrict', 'predCrime', 'predLighting', 'predDensity', 'predPolice'].forEach(id => {
      document.getElementById(id).addEventListener('input', updatePredictorUI);
    });

    document.getElementById('predictorForm').addEventListener('submit', e => {
      e.preventDefault();
      updatePredictorUI();
      showToast('Prediction updated.');
    });

    document.getElementById('savePredToDashboard').addEventListener('click', () => {
      const name = document.getElementById('predName').value.trim() || 'Custom Area';
      const district = document.getElementById('predDistrict').value.trim() || 'Tamil Nadu';
      const crime = Number(document.getElementById('predCrime').value);
      const lighting = Number(document.getElementById('predLighting').value);
      const density = Number(document.getElementById('predDensity').value);
      const police = document.getElementById('predPolice').value;
      const base = areas.find(a => a.id === selectedId) || areas[0];
      const lat = base.lat + (Math.random() - 0.5) * 0.04;
      const lng = base.lng + (Math.random() - 0.5) * 0.04;
      const newArea = {
        id: nextId++,
        name,
        district,
        lat,
        lng,
        crime,
        lighting,
        density,
        police,
        ...classifyArea(crime, lighting, density, police)
      };
      areas.push(newArea);
      selectedId = newArea.id;
      refreshAll();
      switchTab('dashboard');
      showToast(`Saved "${name}" (${newArea.level} Risk) to dashboard.`);
    });

    function triggerSOS() {
      const now = new Date().toLocaleTimeString();
      const coords = document.getElementById('sosCoordsDisplay').textContent;
      const areaName = document.getElementById('sosAreaDisplay').textContent;

      ['statusPolice', 'statusContact1', 'statusContact2'].forEach(id => {
        const el = document.getElementById(id);
        el.textContent = 'Notified';
        el.className = 'px-3 py-2 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300 min-w-[84px] text-center';
      });

      const overall = document.getElementById('sosOverallStatus');
      overall.textContent = 'Live Location Shared';
      overall.className = 'text-xs font-bold px-2.5 py-1 rounded-full bg-red-100 text-red-700';

      alertLogs.unshift({ time: now, area: areaName, coords });
      renderAlertHistory();
      showToast('SOS alert dispatched with live location.');
    }

    function resetSOS() {
      ['statusPolice', 'statusContact1', 'statusContact2'].forEach(id => {
        const el = document.getElementById(id);
        el.textContent = 'Standby';
        el.className = 'px-3 py-2 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 border border-slate-200 min-w-[84px] text-center';
      });
      const overall = document.getElementById('sosOverallStatus');
      overall.textContent = 'Standby';
      overall.className = 'text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600';
      showToast('SOS status reset to standby.');
    }

    function renderAlertHistory() {
      const container = document.getElementById('alertHistory');
      if (alertLogs.length === 0) {
        container.innerHTML = '<p class="text-slate-400 italic">No alerts dispatched in this session.</p>';
        return;
      }
      container.innerHTML = alertLogs.map(log => `
        <div class="p-2.5 rounded-lg bg-red-50 border border-red-200 flex items-center justify-between gap-2">
          <div>
            <p class="font-semibold text-red-900">${log.area}</p>
            <p class="text-[11px] text-red-700">Coords: ${log.coords}</p>
          </div>
          <span class="text-[11px] font-semibold text-red-800">${log.time}</span>
        </div>
      `).join('');
    }

    document.getElementById('sosMainBtn').addEventListener('click', triggerSOS);
    document.getElementById('resetSosBtn').addEventListener('click', resetSOS);
    document.getElementById('bannerSosBtn').addEventListener('click', () => {
      switchTab('sos');
      triggerSOS();
    });

    document.getElementById('detectGpsBtn').addEventListener('click', () => {
      if (!navigator.geolocation) {
        showToast('Geolocation not supported; using selected area coordinates.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        pos => {
          document.getElementById('sosCoordsDisplay').textContent =
            `${pos.coords.latitude.toFixed(4)}, ${pos.coords.longitude.toFixed(4)}`;
          document.getElementById('sosAreaDisplay').textContent = 'Browser Live GPS';
          showToast('Updated coordinates from browser GPS.');
        },
        () => {
          showToast('GPS permission unavailable; using selected area coordinates.');
        },
        { timeout: 5000 }
      );
    });

    function renderDatasetTable() {
      const tbody = document.getElementById('datasetTableBody');
      tbody.innerHTML = areas.map(a => {
        const st = riskStyles(a.level);
        return `
          <tr>
            <td class="py-2 pr-3 font-medium text-slate-900">${a.name}</td>
            <td class="py-2 px-2 text-slate-600">${a.district}</td>
            <td class="py-2 px-2 text-slate-600">${a.crime}</td>
            <td class="py-2 px-2 text-slate-600">${a.lighting}%</td>
            <td class="py-2 px-2 font-semibold text-slate-800">${a.score}</td>
            <td class="py-2 px-2"><span class="px-2 py-0.5 rounded-full text-[11px] font-bold ${st.badge}">${a.level}</span></td>
            <td class="py-2 pl-2 text-right space-x-2">
              <button type="button" data-view-id="${a.id}" class="view-row-btn text-xs font-semibold text-[#0B2A5B] hover:underline">View</button>
              <button type="button" data-del-id="${a.id}" class="del-row-btn text-xs font-semibold text-red-600 hover:underline">Remove</button>
            </td>
          </tr>
        `;
      }).join('');
    }

    document.getElementById('datasetTableBody').addEventListener('click', e => {
      const viewBtn = e.target.closest('.view-row-btn');
      if (viewBtn) {
        selectArea(Number(viewBtn.dataset.viewId));
        switchTab('dashboard');
        return;
      }
      const delBtn = e.target.closest('.del-row-btn');
      if (delBtn) {
        if (areas.length <= 1) {
          showToast('At least one area must remain in the dataset.');
          return;
        }
        const id = Number(delBtn.dataset.delId);
        areas = areas.filter(a => a.id !== id);
        if (selectedId === id) selectedId = areas[0].id;
        refreshAll();
        showToast('Area removed.');
      }
    });

    document.getElementById('addAreaForm').addEventListener('submit', e => {
      e.preventDefault();
      const name = document.getElementById('newAreaName').value.trim();
      const district = document.getElementById('newAreaDistrict').value.trim() || 'Tamil Nadu';
      const lat = Number(document.getElementById('newAreaLat').value);
      const lng = Number(document.getElementById('newAreaLng').value);
      const crime = Number(document.getElementById('newAreaCrime').value);
      const lighting = Number(document.getElementById('newAreaLight').value);
      const density = Number(document.getElementById('newAreaDensity').value);
      const police = document.getElementById('newAreaPolice').value;

      if (!name) return;
      const added = {
        id: nextId++,
        name,
        district,
        lat,
        lng,
        crime,
        lighting,
        density,
        police,
        ...classifyArea(crime, lighting, density, police)
      };
      areas.push(added);
      document.getElementById('newAreaName').value = '';
      refreshAll();
      showToast(`Added "${name}" (${district}) to dataset.`);
    });

    document.getElementById('retrainBtn').addEventListener('click', () => {
      areas = areas.map(a => ({ ...a, ...classifyArea(a.crime, a.lighting, a.density, a.police) }));
      refreshAll();
      showToast(`Model retrained across ${areas.length} Tamil Nadu areas.`);
    });

    function refreshAll() {
      populateDistrictDropdown();
      renderKPIs();
      renderSelectedArea();
      renderAreaList();
      renderChart();
      renderMarkers();
      renderDatasetTable();
    }

    window.addEventListener('DOMContentLoaded', () => {
      initMap();
      refreshAll();
      updatePredictorUI();
    });
  </script>
</body>
</html>
